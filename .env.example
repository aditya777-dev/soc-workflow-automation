# SOC Workflow Automation — API Key Configuration
# Copy this file to .env and fill in your real API keys.
# NEVER commit .env to version control.

# VirusTotal free API key
# Sign up at: https://www.virustotal.com/gui/sign-in
# Free tier: 4 requests/minute, 500 lookups/day
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# AbuseIPDB free API key
# Sign up at: https://www.abuseipdb.com/register
# Free tier: 1,000 checks/day
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
